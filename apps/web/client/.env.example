# Vite dev environment — copy to .env.local (or .env):  cp .env.example .env.local
# Only variables prefixed VITE_ are exposed to browser code (import.meta.env).
# Never put secrets here — everything in this file ships to the browser.

# Backend base URL for client-side fetch (M0-23/M0-24).
# The browser must reach this directly — CORS is enforced by services/api.
# Local:  http://localhost:8000
# Docker: use http://localhost:8000 from the host browser (api:8000 is Docker-network only)
VITE_API_URL=http://localhost:8000

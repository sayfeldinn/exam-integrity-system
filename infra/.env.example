# infra/.env.example — canonical env contract (M0-8 M0:114)
# Copy to infra/.env:  cp infra/.env.example infra/.env
# Validate:  docker compose -f infra/docker-compose.yml config
# Never commit infra/.env (see .gitignore)
#
# Required by: services/api/core/config.py (pydantic-settings), apps/web/client (VITE_API_URL),
#              infra/docker-compose.yml (env_file)

# --- Postgres (used by services/api and docker-compose postgres service) ---
POSTGRES_USER=exam_user
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=exam_integrity
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Unified DB URL — api prefers this (M0-15 M0:132)
# Format: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://exam_user:change-me-local-only@postgres:5432/exam_integrity

# --- API ---
API_PORT=8000
# Must match the above; fail-fast if missing (pydantic-settings BaseSettings)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# CORS — backend CORSMiddleware allow_origins (M0-16 M0:133)
# Comma-separated list; local dev needs the Vite dev server (5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Web (Vite/React, client-side fetch) ---
WEB_PORT=5173
# Browser fetch target (NOT http://api:8000 — that is Docker network only; see M0-24 M0:152)
# Local:  http://localhost:8000
# Docker: api reachable as http://api:8000 internally, but browser needs localhost
# Consumed by apps/web/client as import.meta.env.VITE_API_URL (Vite only exposes VITE_* vars)
VITE_API_URL=http://localhost:8000

# --- Post-MVP (M4, one uncomment) ---
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=exam-recordings
